Script[15]=
Script[16]='' example Script
Script[17]=' this is the main function called by when the run script button is pressed
Script[18]=' the function is passed the current title of the motor project
Script[19]=Function MainFunction(Title)
Script[20]=dim mcad
Script[21]=set mcad = createobject("motorcad.appautomation")
Script[22]=call mcad.showmessage("example of script for "+ Title)
Script[23]=
Script[24]=' speed up the set by setting to avoid immediate update of input
Script[25]=call mcad.AvoidImmediateUpdate(true)
Script[26]=
Script[27]=' display the messages in a separate window
Script[28]=call mcad.SetVariable("ERROR_MESSAGES_DISABLED",1)
Script[29]=
Script[30]=' set the radial cross section display
Script[31]='call mcad.DisplayScreen("Radial")
Script[32]=
Script[33]=' example of call to a separate function
Script[34]=mySecondFunction(mcad)
Script[35]=
Script[36]=' set the scripting display
Script[37]=call mcad.DisplayScreen("Scripting")
Script[38]=
Script[39]=
Script[40]=
Script[41]=End Function
Script[42]=
Script[43]=' this is an example of a separate function that takes mcad as a parameter
Script[44]=Function mySecondFunction(mcad)
Script[45]=for toothWidth = 1 to 3 step .5
Script[46]=call mcad.showmessage("Tooth width = " + CStr(toothWidth))
Script[47]=call mcad.SetVariable("Tooth_Width", toothWidth)
Script[48]=call mcad.DoSteadyStateAnalysis
Script[49]=call mcad.GetVariable("T_[WINDING_AVERAGE]", temperature)
Script[50]=call mcad.showmessage("Winding temperature = " + CStr(temperature))
Script[51]=
Script[52]=' to be able to stop a script from the stop button need this code in the innermost loop
Script[53]=' this asks Motor-CAD if the stop button has been pressed
Script[54]=if mcad.IsStopRequested then exit function end if
Script[55]=
Script[56]=
Script[57]=Next
Script[58]=
Script[59]=
Script[60]='  myExcelCall
Script[61]=
Script[62]=End Function
Script[63]=
Script[64]=' this function is called the first time when scripting is run during the analysis
Script[65]=' this allows parameters to be initialised
Script[66]=Function Initialisation(Title)
Script[67]=
Script[68]=End Function
Script[69]=
Script[70]=' this function is called when scripting is run during the analysis after the duty cycle has completed
Script[71]=' this allows any calculations to be made at the end of the transient
Script[72]=Function Finalisation(Title)
Script[73]=
Script[74]=End Function
Script[75]=
Script[76]=
Script[77]=
Script[78]=
Script[79]=' this is an example of putting values into excel
Script[80]='Function myExcelCall
Script[81]='  dim excel
Script[82]='  set excel = createObject("excel.application")
Script[83]='  excel.visible = TRUE
Script[84]='  excel.workbooks.add
Script[85]=
Script[86]='  excel.cells(1,1).value = "temperature"
Script[87]='End Function

