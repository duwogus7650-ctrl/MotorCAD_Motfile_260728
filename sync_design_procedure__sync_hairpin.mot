Script[11]=
Script[12]='' example Script
Script[13]=' this is the main function called by when the run script button is pressed
Script[14]=' the function is passed the current title of the motor project
Script[15]=Function MainFunction(Title)
Script[16]=dim mcad
Script[17]=set mcad = createobject("motorcad.appautomation")
Script[18]=call mcad.showmessage("example of script for "+ Title)
Script[19]=
Script[20]=' speed up the set by setting to avoid immediate update of input
Script[21]=call mcad.AvoidImmediateUpdate(true)
Script[22]=
Script[23]=' display the messages in a separate window
Script[24]=call mcad.SetVariable("ERROR_MESSAGES_DISABLED",1)
Script[25]=
Script[26]=' set the radial cross section display
Script[27]='call mcad.DisplayScreen("Radial")
Script[28]=
Script[29]=' example of call to a separate function
Script[30]=mySecondFunction(mcad)
Script[31]=
Script[32]=' set the scripting display
Script[33]=call mcad.DisplayScreen("Scripting")
Script[34]=
Script[35]=
Script[36]=
Script[37]=End Function
Script[38]=
Script[39]=' this is an example of a separate function that takes mcad as a parameter
Script[40]=Function mySecondFunction(mcad)
Script[41]=for toothWidth = 1 to 3 step .5
Script[42]=call mcad.showmessage("Tooth width = " + CStr(toothWidth))
Script[43]=call mcad.SetVariable("Tooth_Width", toothWidth)
Script[44]=call mcad.DoSteadyStateAnalysis
Script[45]=call mcad.GetVariable("T_[WINDING_AVERAGE]", temperature)
Script[46]=call mcad.showmessage("Winding temperature = " + CStr(temperature))
Script[47]=
Script[48]=' to be able to stop a script from the stop button need this code in the innermost loop
Script[49]=' this asks Motor-CAD if the stop button has been pressed
Script[50]=if mcad.IsStopRequested then exit function end if
Script[51]=
Script[52]=
Script[53]=Next
Script[54]=
Script[55]=
Script[56]='  myExcelCall
Script[57]=
Script[58]=End Function
Script[59]=
Script[60]=' this function is called the first time when scripting is run during the analysis
Script[61]=' this allows parameters to be initialised
Script[62]=Function Initialisation(Title)
Script[63]=
Script[64]=End Function
Script[65]=
Script[66]=' this function is called when scripting is run during the analysis after the duty cycle has completed
Script[67]=' this allows any calculations to be made at the end of the transient
Script[68]=Function Finalisation(Title)
Script[69]=
Script[70]=End Function
Script[71]=
Script[72]=
Script[73]=
Script[74]=
Script[75]=' this is an example of putting values into excel
Script[76]='Function myExcelCall
Script[77]='  dim excel
Script[78]='  set excel = createObject("excel.application")
Script[79]='  excel.visible = TRUE
Script[80]='  excel.workbooks.add
Script[81]=
Script[82]='  excel.cells(1,1).value = "temperature"
Script[83]='End Function

