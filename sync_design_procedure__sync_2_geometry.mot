Script[12]=
Script[13]='' example Script
Script[14]=' this is the main function called by when the run script button is pressed
Script[15]=' the function is passed the current title of the motor project
Script[16]=Function MainFunction(Title)
Script[17]=dim mcad
Script[18]=set mcad = createobject("motorcad.appautomation")
Script[19]=call mcad.showmessage("example of script for "+ Title)
Script[20]=
Script[21]=' speed up the set by setting to avoid immediate update of input
Script[22]=call mcad.AvoidImmediateUpdate(true)
Script[23]=
Script[24]=' display the messages in a separate window
Script[25]=call mcad.SetVariable("ERROR_MESSAGES_DISABLED",1)
Script[26]=
Script[27]=' set the radial cross section display
Script[28]='call mcad.DisplayScreen("Radial")
Script[29]=
Script[30]=' example of call to a separate function
Script[31]=mySecondFunction(mcad)
Script[32]=
Script[33]=' set the scripting display
Script[34]=call mcad.DisplayScreen("Scripting")
Script[35]=
Script[36]=
Script[37]=
Script[38]=End Function
Script[39]=
Script[40]=' this is an example of a separate function that takes mcad as a parameter
Script[41]=Function mySecondFunction(mcad)
Script[42]=for toothWidth = 1 to 3 step .5
Script[43]=call mcad.showmessage("Tooth width = " + CStr(toothWidth))
Script[44]=call mcad.SetVariable("Tooth_Width", toothWidth)
Script[45]=call mcad.DoSteadyStateAnalysis
Script[46]=call mcad.GetVariable("T_[WINDING_AVERAGE]", temperature)
Script[47]=call mcad.showmessage("Winding temperature = " + CStr(temperature))
Script[48]=
Script[49]=' to be able to stop a script from the stop button need this code in the innermost loop
Script[50]=' this asks Motor-CAD if the stop button has been pressed
Script[51]=if mcad.IsStopRequested then exit function end if
Script[52]=
Script[53]=
Script[54]=Next
Script[55]=
Script[56]=
Script[57]='  myExcelCall
Script[58]=
Script[59]=End Function
Script[60]=
Script[61]=' this function is called the first time when scripting is run during the analysis
Script[62]=' this allows parameters to be initialised
Script[63]=Function Initialisation(Title)
Script[64]=
Script[65]=End Function
Script[66]=
Script[67]=' this function is called when scripting is run during the analysis after the duty cycle has completed
Script[68]=' this allows any calculations to be made at the end of the transient
Script[69]=Function Finalisation(Title)
Script[70]=
Script[71]=End Function
Script[72]=
Script[73]=
Script[74]=
Script[75]=
Script[76]=' this is an example of putting values into excel
Script[77]='Function myExcelCall
Script[78]='  dim excel
Script[79]='  set excel = createObject("excel.application")
Script[80]='  excel.visible = TRUE
Script[81]='  excel.workbooks.add
Script[82]=
Script[83]='  excel.cells(1,1).value = "temperature"
Script[84]='End Function

